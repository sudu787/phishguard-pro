# .env.example — copy to .env and fill in your values

# ── Server ────────────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ── CORS: Replace with your actual Chrome Extension ID ───────────────────────
# Find it at chrome://extensions after loading unpacked extension
CORS_ORIGINS=["chrome-extension://YOUR_EXTENSION_ID_HERE","http://localhost:3000"]

# ── Model paths (relative to backend/ working directory) ─────────────────────
URL_MODEL_PATH=ml_pipeline/models/url_xgboost.json
DOM_MODEL_PATH=ml_pipeline/models/dom_rf.joblib

# ── Detection thresholds ──────────────────────────────────────────────────────
PHISHING_THRESHOLD=0.65
SUSPICIOUS_THRESHOLD=0.40

# ── Threat intelligence ───────────────────────────────────────────────────────
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/url/
INTEL_CACHE_TTL=3600
